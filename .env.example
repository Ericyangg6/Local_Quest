# Snowflake setup scripts (snowflake/scripts/lq.py) read this file. Copy to local-quest/.env.
# Never commit .env. Empty values are treated as unset. Real environment variables override it.
# The web app does NOT read this file: its settings go in web/.env.local (see web/.env.example).

SNOWFLAKE_ACCOUNT=              # <orgname>-<account_name>, e.g. ABCDEFG-XY12345
SNOWFLAKE_USER=                 # the owner's LOGIN name (key-pair auth uses it)
SNOWFLAKE_PRIVATE_KEY_PATH=     # absolute path to the owner's .p8 key, kept outside the repository
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=LQ_OWNER         # creates tables, loads data, deploys the procedure
SNOWFLAKE_WAREHOUSE=LQ_WH
SNOWFLAKE_DATABASE=LOCAL_QUEST
