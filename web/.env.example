# Copy to .env.local for development (never commit real values).
# In production, set these in your hosting provider's environment settings.

# Encrypts session cookies and signs tokens. Generate with: npx auth secret
# (or: openssl rand -base64 32). Use a different value per environment.
AUTH_SECRET=

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://YOUR_DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# MongoDB connection string, including the database name.
# Local example: mongodb://localhost:27017/localquest
DATABASE_URL=

# Production only, when behind a reverse proxy / load balancer:
# AUTH_TRUST_HOST=true     lets Auth.js trust the forwarded host header
# TRUST_PROXY=true         uses X-Forwarded-For for per-IP rate limiting
# Optional: sign-in attempts allowed per IP per 15 minutes (default 30). Raise it when
# many players share one IP, e.g. campus Wi-Fi at a demo.
# SIGN_IN_LIMIT_PER_IP=30

# ---------- Quest planner ----------
# mock (default): offline demo places, labeled "Demo"; refused in production unless
#   ALLOW_MOCK_IN_PRODUCTION=true. snowflake: live Snowflake place search + Cortex model.
QUEST_PLANNER=mock
# IANA time zone for quest start/arrival times.
QUEST_TIMEZONE=America/Los_Angeles

# Snowflake (QUEST_PLANNER=snowflake). Server-only; never exposed to the browser.
# Use the app's least-privilege login (role LQ_APP_RO), not the owner's.
SNOWFLAKE_ACCOUNT=              # <orgname>-<account_name>, e.g. ABCDEFG-XY12345
SNOWFLAKE_USER=                 # LOGIN name of the key-pair user
# Either the key text (hosted: paste the whole .p8; literal \n is fine) or a key file (local).
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=   # only for an encrypted key
SNOWFLAKE_ROLE=LQ_APP_RO
SNOWFLAKE_WAREHOUSE=LQ_WH
SNOWFLAKE_DATABASE=LOCAL_QUEST
SNOWFLAKE_SCHEMA=APP
SNOWFLAKE_AI_MODEL=llama3.3-70b
# SNOWFLAKE_LOCATIONS_PROCEDURE=LOCAL_QUEST.APP.FIND_QUEST_LOCATIONS
# Per statement; one quest runs three. Model calls take up to ~20 s.
SNOWFLAKE_QUERY_TIMEOUT_S=40

# Production outside Vercel (Docker, Render, Railway, a VM): Auth.js must trust the Host header.
# AUTH_TRUST_HOST=true
